                    {
                        "id": "ca996186-85ad-45c3-a46d-610c36385da8",
                        "type": 3,
                        "name": "query - 0",
                        "content": {
                            "version": "KqlItem/1.0",
                            "query": "SecurityIncident\r\n| summarize arg_max(TimeGenerated,*) by IncidentNumber\r\n| summarize Count=count() by Title, Status\r\n| sort by Count desc",
                            "size": 0,
                            "queryType": 0,
                            "resourceType": "microsoft.operationalinsights/workspaces",
                            "timeContextFromParameter": "timeRange",
                            "title": "Incidents by Volume",
                            "exportMultipleValues": true,
                            "exportedParameters": [
                                {
                                    "parameterType": 1,
                                    "fieldName": "Title",
                                    "parameterName": "incidentName",
                                    "quote": "\"",
                                    "delimiter": ","
                                }
                            ]
                        },
                        "customWidth": "70"
                    },
                    {
                        "id": "4aefc7c2-4265-4761-8c62-e10ae124930c",
                        "type": 3,
                        "name": "query - 2",
                        "content": {
                            "version": "KqlItem/1.0",
                            "query": "let selectedIncidents = dynamic([{incidentName}]);\r\nSecurityIncident\r\n| summarize arg_max(TimeGenerated,*) by IncidentNumber\r\n| where Status == \"Closed\"\r\n| where array_length(selectedIncidents) == 0\r\n    or Title in (selectedIncidents)\r\n| extend Closure = iff(isempty(Classification), \"None\", Classification)\r\n| summarize IncCount=count() by Closure",
                            "size": 0,
                            "queryType": 0,
                            "resourceType": "microsoft.operationalinsights/workspaces",
                            "title": "Closure by Classification",
                            "visualization": "piechart",
                            "exportedParameters": [
                                {
                                    "parameterType": 1,
                                    "fieldName": "Closure",
                                    "parameterName": "closure"
                                }
                            ],
                            "timeContextFromParameter": "timeRange"
                        },
                        "customWidth": "30"
                    },
                    {
                        "id": "7adc06c1-2ed1-467a-80cb-7c1362becb3d",
                        "type": 3,
                        "name": "query - 3",
                        "content": {
                            "version": "KqlItem/1.0",
                            "query": "let selectedIncidents = dynamic([{incidentName}]);\r\nlet selectedClosures  = dynamic([{closure}]);\r\nSecurityIncident\r\n| summarize arg_max(TimeGenerated,*) by IncidentNumber\r\n| where Status == \"Closed\"\r\n| where array_length(selectedIncidents) == 0\r\n    or Title in (selectedIncidents)\r\n| where array_length(selectedClosures) == 0\r\n    or Classification in (selectedClosures)\r\n| extend TimeToClosure = iff(isnotempty(ClosedTime), round((ClosedTime - CreatedTime)/1h, 2), real(null))\r\n| project\r\n    IncidentNumber,\r\n    Title,\r\n    Severity,\r\n    Status,\r\n    Classification,\r\n    ClassificationComment,\r\n    TimeToClosure,\r\n    Owner.userPrincipalName,\r\n    CreatedTime,\r\n    ClosedTime\r\n| order by CreatedTime desc",
                            "size": 0,
                            "queryType": 0,
                            "resourceType": "microsoft.operationalinsights/workspaces",
                            "timeContextFromParameter": "timeRange",
                            "title": "Incident Closure Information",
                            "showExportToExcel": true,
                            "exportToExcelOptions": "visible"
                        }
                    },
                    {
                        "id": "e5e5e5e5-1111-2222-3333-eeeeeeeeeeee",
                        "type": 3,
                        "name": "Repetitive Incidents by Avg Handle Time",
                        "content": {
                            "version": "KqlItem/1.0",
                            "query": "let selectedIncidents = dynamic([{incidentName}]);\r\nSecurityIncident\r\n| summarize arg_max(TimeGenerated,*) by IncidentNumber\r\n| where Status == \"Closed\"\r\n| where array_length(selectedIncidents) == 0\r\n    or Title in (selectedIncidents)\r\n| extend HandleTime = round((ClosedTime - CreatedTime)/1h, 2)\r\n| summarize\r\n    IncidentCount=count(),\r\n    AvgHandleTime=round(avg(HandleTime), 2),\r\n    MedianHandleTime=round(percentile(HandleTime, 50), 2),\r\n    MinHandleTime=round(min(HandleTime), 2),\r\n    MaxHandleTime=round(max(HandleTime), 2)\r\n    by Title\r\n| where IncidentCount >= 3\r\n| extend AutomationScore = round(toreal(IncidentCount) / AvgHandleTime, 2)\r\n| sort by AutomationScore desc",
                            "size": 0,
                            "queryType": 0,
                            "resourceType": "microsoft.operationalinsights/workspaces",
                            "timeContextFromParameter": "timeRange",
                            "title": "Automation Candidates — High Volume, Low Handle Time",
                            "showExportToExcel": true,
                            "exportToExcelOptions": "visible"
                        }
                    }
                ]
            },
